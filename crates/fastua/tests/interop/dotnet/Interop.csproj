<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>fastua-interop-dotnet</AssemblyName>
    <NoWarn>CS1998;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- OPC Foundation reference stack (UA-.NETStandard). -->
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.378.196" />
  </ItemGroup>
</Project>
